{
	"name": "@evex-dev/xrpc-hono",
	"private": false,
	"version": "2.0.0",
	"description": "A XRPC server implementation for Hono.",
	"type": "module",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		}
	},
	"types": "./dist/index.d.ts",
	"bin": {
		"gen-xrpc-hono": "./dist/cli/index.js"
	},
	"scripts": {
		"check": "biome check --write",
		"build": "tsc",
		"typecheck": "tsc --noEmit && tsc --noEmit -p test/tsconfig.json",
		"test": "vitest run",
		"test:unit": "vitest run --project unit",
		"test:e2e": "vitest run --project e2e",
		"prepack": "tsc"
	},
	"files": [
		"dist",
		"src"
	],
	"keywords": [
		"atproto",
		"hono",
		"xrpc",
		"xrpc-server",
		"lexicon",
		"cli"
	],
	"author": "evex-dev",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git://github.com/evex-dev/xrpc-hono.git"
	},
	"dependencies": {
		"@atproto/lex-cbor": "^0.1.7",
		"@atproto/lexicon": "^0.7.11",
		"@atproto/syntax": "^0.7.4",
		"@atproto/xrpc": "^0.8.10",
		"chalk": "^5.6.2",
		"commander": "^14.0.1",
		"hono": "^4.9.8",
		"http-errors": "^2.0.0",
		"prettier": "^3.6.2",
		"ts-morph": "^27.0.0",
		"yesno": "^0.4.0",
		"zod": "^4.1.11"
	},
	"devDependencies": {
		"@atproto/xrpc-server": "^0.13.5",
		"@biomejs/biome": "2.2.4",
		"@hono/node-server": "^1.19.17",
		"@hono/node-ws": "^1.3.1",
		"@types/http-errors": "^2.0.5",
		"@types/node": "^24.5.2",
		"cborg": "^4.5.8",
		"multiformats": "^13.4.2",
		"typescript": "^5.9.2",
		"vitest": "^5.0.5"
	}
}
